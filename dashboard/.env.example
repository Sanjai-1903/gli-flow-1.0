# Copy to .env.local (dev) or set as Vercel env vars (prod).
#
# All three are safe to commit as anon/public. Do NOT put the service_role key
# in this file — that stays on the ingest server only.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
VITE_INGEST_URL=http://localhost:8100
